# Copia este archivo como ".env" y rellena los valores.
# El archivo ".env" NUNCA se sube a git (mira .gitignore).

# Cadena de conexión a tu base de datos Postgres gratuita en Neon
# (neon.com, plan Free, sin tarjeta). En el panel de Neon, cópiala desde
# "Connection string" (formato: postgresql://usuario:contraseña@host/basededatos?sslmode=require).
DATABASE_URL=""

# Contraseña del panel /admin.
# IMPORTANTE: aquí NO va la contraseña en texto plano, va su hash (bcrypt).
# Para generar el hash, ejecuta en la terminal:
#   npm run hash-password -- "tu-contraseña-elegida"
# y copia el resultado aquí.
ADMIN_PASSWORD_HASH=""

# Clave secreta usada para firmar la cookie de sesión del admin.
# Pon cualquier cadena larga y aleatoria (por ejemplo, 40+ caracteres).
SESSION_SECRET="cambia-esto-por-una-cadena-secreta-larga-y-aleatoria"
